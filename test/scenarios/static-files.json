{
  "$schema": "./_schema.json",
  "description": "Static assets, file serving and SSR/SSG frameworks: exact files vs extension routes vs SPA fallbacks, Nuxt/Nitro payloads and route rules, Next.js/SvelteKit catch-alls, dotfiles, traversal and encoded file names",
  "sources": [
    "README and docs/reference.md: Route patterns (Params, Wildcards, Percent-encoding, Invalid patterns, Differences from URLPattern)",
    "README and docs/reference.md: Matching (Trailing slashes and empty segments, Path normalization, Result ordering incl. 'Segments after a catch-all')",
    "README and docs/reference.md: Regular expressions (regex ≡ router, used as a guard)",
    ".agents/matching.md: greedy `*`, segments after a catch-all, empty segments",
    "Nitro route rules / Nuxt payload extraction (`/**/_payload.json`, `/_ipx/**`, `/api/_content/**`), Nuxt OG image",
    "Next.js dynamic routes (`[...slug]`, `[[...slug]]`), SvelteKit rest params and matchers, Vite dev server URLs (`/@fs/`, `/@id/`, `/node_modules/.vite/deps/`)"
  ],
  "scenarios": [
    {
      "name": "asset server with exact files and a SPA fallback",
      "description": "A typical SPA host: a `/**` index.html fallback, exact root files, asset mounts in every common spelling and a method-agnostic API scope.",
      "routes": [
        { "path": "/**", "name": "spa" },
        { "path": "/favicon.ico", "name": "favicon" },
        { "path": "/robots.txt", "name": "robots" },
        { "path": "/assets/**", "name": "assets" },
        { "path": "/_nuxt/**", "name": "nuxt" },
        { "path": "/static/*", "name": "static" },
        { "method": "", "path": "/api/**", "name": "api" }
      ],
      "cases": [
        { "path": "/", "match": "spa", "params": {}, "all": ["spa"] },
        { "path": "/favicon.ico", "match": "favicon", "params": {}, "all": ["spa", "favicon"] },
        { "path": "/favicon.ico/", "match": "favicon", "note": "one trailing slash is ignored" },
        { "path": "/robots.txt", "match": "robots", "all": ["spa", "robots"] },
        { "path": "/FAVICON.ICO", "match": "spa", "params": { "0": "FAVICON.ICO" }, "note": "case-sensitive" },
        { "path": "/favicon.ico/x", "match": "spa", "params": { "0": "favicon.ico/x" } },
        { "path": "/assets/app.js", "match": "assets", "params": { "0": "app.js" }, "all": ["spa", "assets"] },
        { "path": "/assets", "match": "assets", "params": {}, "all": ["spa", "assets"] },
        { "path": "/assets/", "match": "assets", "params": {} },
        { "path": "/assets/js/chunk-abc.js", "match": "assets", "params": { "0": "js/chunk-abc.js" } },
        { "path": "/static/logo.svg", "match": "static", "params": { "0": "logo.svg" }, "all": ["spa", "static"] },
        { "path": "/static", "match": "static", "params": {} },
        { "path": "/static/", "match": "static", "params": { "0": "" } },
        { "path": "/static/img/a/b.png", "match": "static", "params": { "0": "img/a/b.png" } },
        { "path": "/_nuxt/entry.CkX3.js", "match": "nuxt", "params": { "0": "entry.CkX3.js" } },
        { "path": "/about/team", "match": "spa", "params": { "0": "about/team" } },
        { "path": "/.env", "match": "spa", "params": { "0": ".env" } },
        { "method": "POST", "path": "/assets/app.js", "match": null, "all": [] },
        { "method": "POST", "path": "/api/upload", "match": "api", "params": { "0": "upload" }, "all": ["api"] },
        { "path": "/api/users", "match": "api", "all": ["spa", "api"] },
        { "path": "/assets/../.env", "match": "assets", "params": { "0": "../.env" }, "note": "no normalization by default" },
        { "path": "/assets/../.env", "normalize": true, "match": "spa", "params": { "0": ".env" } },
        { "path": "/static/../../robots.txt", "normalize": true, "match": "robots" },
        { "path": "/static/img/..", "normalize": true, "match": "static", "params": { "0": "" }, "note": "a last `..` leaves a trailing slash, which a trailing `*` reads" },
        { "path": "/assets/%2e%2e/.env", "normalize": true, "match": "assets", "params": { "0": "%2e%2e/.env" }, "note": "paths are never decoded; new URL() would already have resolved it" }
      ]
    },
    {
      "name": "file mounts in every catch-all spelling",
      "description": "Trailing slashes and empty segments per spelling (README 'Trailing slashes and empty segments' and the 0.12 notes): `*`, `**`, `(.*)` and `:name(.*)` take empty segments, `**:name`, `:name+` and `:name*` never do.",
      "routes": [
        { "path": "/assets/**", "name": "assets" },
        { "path": "/static/*", "name": "static" },
        { "path": "/files/**:path", "name": "files" },
        { "path": "/downloads/:path+", "name": "downloads" },
        { "path": "/docs/:slug*", "name": "docs" },
        { "path": "/media/:path(.*)", "name": "media" },
        { "path": "/raw/(.*)", "name": "raw" }
      ],
      "cases": [
        { "path": "/assets", "match": "assets", "params": {} },
        { "path": "/assets/", "match": "assets", "params": {} },
        { "path": "/assets//", "match": "assets", "params": { "0": "" } },
        { "path": "/assets/a/b", "match": "assets", "params": { "0": "a/b" } },
        { "path": "/assets/a/b/", "match": "assets", "params": { "0": "a/b" } },
        { "path": "/assets//a", "match": "assets", "params": { "0": "/a" } },
        { "path": "/assets/a//b", "match": "assets", "params": { "0": "a//b" } },
        { "path": "/assets/a//", "match": "assets", "params": { "0": "a/" } },
        { "path": "/static", "match": "static", "params": {} },
        { "path": "/static/", "match": "static", "params": { "0": "" } },
        { "path": "/static//", "match": "static", "params": { "0": "" } },
        { "path": "/static/a/b/", "match": "static", "params": { "0": "a/b" } },
        { "path": "/static//a", "match": "static", "params": { "0": "/a" } },
        { "path": "/static/a//", "match": "static", "params": { "0": "a/" } },
        { "path": "/files", "match": null },
        { "path": "/files/", "match": null },
        { "path": "/files//", "match": null },
        { "path": "/files/a/b/", "match": "files", "params": { "path": "a/b" } },
        { "path": "/files//a", "match": null },
        { "path": "/files/a//b", "match": null },
        { "path": "/files/a//", "match": null },
        { "path": "/downloads/a", "match": "downloads", "params": { "path": "a" } },
        { "path": "/downloads/a/b.zip", "match": "downloads", "params": { "path": "a/b.zip" } },
        { "path": "/downloads", "match": null },
        { "path": "/downloads/a//b", "match": null },
        { "path": "/docs", "match": "docs", "params": {} },
        { "path": "/docs/", "match": "docs", "params": {} },
        { "path": "/docs//", "match": null },
        { "path": "/docs/a/b", "match": "docs", "params": { "slug": "a/b" } },
        { "path": "/docs/a//b", "match": null },
        { "path": "/media", "match": "media", "params": {} },
        { "path": "/media/", "match": "media", "params": { "path": "" } },
        { "path": "/media//", "match": "media", "params": { "path": "" } },
        { "path": "/media/a/b", "match": "media", "params": { "path": "a/b" } },
        { "path": "/media//a", "match": "media", "params": { "path": "/a" } },
        { "path": "/media/a//b", "match": "media", "params": { "path": "a//b" } },
        { "path": "/raw", "match": "raw", "params": {} },
        { "path": "/raw/", "match": "raw", "params": { "0": "" } },
        { "path": "/raw/a/b", "match": "raw", "params": { "0": "a/b" } }
      ]
    },
    {
      "name": "extension routes anchored at the end with a SPA fallback",
      "description": "`/*.json`, `/**.md` (≡ `/*.md`) and `/images/*.png` match from the end of the path and beat the `/**` fallback.",
      "routes": [
        { "path": "/**", "name": "spa" },
        { "path": "/*.json", "name": "json" },
        { "path": "/**.md", "name": "md" },
        { "path": "/images/*.png", "name": "png" }
      ],
      "cases": [
        { "path": "/manifest.json", "match": "json", "params": { "0": "manifest" }, "all": ["spa", "json"] },
        { "path": "/api/data/users.json", "match": "json", "params": { "0": "api/data/users" } },
        { "path": "/.json", "match": "json", "params": { "0": "" } },
        { "path": "/README.md", "match": "md", "params": { "0": "README" }, "all": ["spa", "md"] },
        { "path": "/docs/guide/intro.md", "match": "md", "params": { "0": "docs/guide/intro" } },
        { "path": "/docs/intro.md/", "match": "md", "params": { "0": "docs/intro" } },
        { "path": "/docs/intro.md//", "match": "spa", "params": { "0": "docs/intro.md/" }, "note": "the last segment is empty" },
        { "path": "/images/logo.png", "match": "png", "params": { "0": "logo" }, "all": ["spa", "png"] },
        { "path": "/images/icons/x.png", "match": "png", "params": { "0": "icons/x" } },
        { "path": "/images/logo.jpg", "match": "spa", "params": { "0": "images/logo.jpg" } },
        { "path": "/images/.png", "match": "png", "params": { "0": "" } },
        { "path": "/images//a.png", "match": "png", "params": { "0": "/a" } },
        { "path": "/images/logo.png.json", "match": "json", "params": { "0": "images/logo.png" }, "all": ["spa", "json"] },
        { "path": "/images/notes.md", "match": "md", "params": { "0": "images/notes" } },
        { "path": "/notes.json.md", "match": "md", "params": { "0": "notes.json" } },
        { "path": "/images/a.md.png", "match": "png", "params": { "0": "a.md" }, "all": ["spa", "png"] },
        { "path": "/x.png", "match": "spa", "params": { "0": "x.png" } },
        { "path": "/data.JSON", "match": "spa" },
        { "path": "/", "match": "spa", "params": {}, "all": ["spa"] }
      ]
    },
    {
      "name": "root file names with `/:name.:ext`",
      "description": "A dotted root route next to a page route, an exact file and a fallback: params in a segment are lazy, so the name stops at the first dot.",
      "routes": [
        { "path": "/**", "name": "spa" },
        { "path": "/favicon.ico", "name": "favicon" },
        { "path": "/:name.:ext", "name": "root-file" },
        { "path": "/:page", "name": "page" }
      ],
      "cases": [
        { "path": "/sitemap.xml", "match": "root-file", "params": { "name": "sitemap", "ext": "xml" }, "all": ["spa", "page", "root-file"] },
        { "path": "/favicon.ico", "match": "favicon", "params": {}, "all": ["spa", "page", "root-file", "favicon"] },
        { "path": "/about", "match": "page", "params": { "page": "about" }, "all": ["spa", "page"] },
        { "path": "/jquery.min.js", "match": "root-file", "params": { "name": "jquery", "ext": "min.js" } },
        { "path": "/.env", "match": "page", "params": { "page": ".env" }, "note": "the name needs a character before the dot" },
        { "path": "/.env.local", "match": "root-file", "params": { "name": ".env", "ext": "local" } },
        { "path": "/file.", "match": "page", "params": { "page": "file." } },
        { "path": "/v1.2/", "match": "root-file", "params": { "name": "v1", "ext": "2" } },
        { "path": "/a/b.js", "match": "spa", "params": { "0": "a/b.js" } },
        { "path": "/", "match": "spa", "params": {} }
      ]
    },
    {
      "name": "competing extension routes in one directory",
      "description": "An exact file, an image-only route, any `name.ext`, a `*.pdf` that spans directories, and a `:path+` catch-all for the rest.",
      "routes": [
        { "path": "/files/:path+", "name": "path" },
        { "path": "/files/:name.:ext", "name": "any-ext" },
        { "path": "/files/:name.:ext(png|jpg|webp)", "name": "image" },
        { "path": "/files/*.pdf", "name": "pdf" },
        { "path": "/files/report.pdf", "name": "report" }
      ],
      "cases": [
        { "path": "/files/a.png", "match": "image", "params": { "name": "a", "ext": "png" }, "all": ["path", "any-ext", "image"], "note": "`:name.:ext(png|jpg|webp)` ⊊ `:name.:ext`: same weight, but a constraint in the segment ranks higher" },
        { "path": "/files/photo.final.webp", "match": "image", "params": { "name": "photo.final", "ext": "webp" }, "note": "the image route's lazy name backtracks to leave `webp` for its constraint" },
        { "path": "/files/a.PNG", "match": "any-ext", "params": { "name": "a", "ext": "PNG" } },
        { "path": "/files/archive.tar.gz", "match": "any-ext", "params": { "name": "archive", "ext": "tar.gz" }, "all": ["path", "any-ext"] },
        { "path": "/files/report.pdf", "match": "report", "params": {}, "all": ["path", "pdf", "any-ext", "report"] },
        { "path": "/files/a.pdf", "match": "any-ext", "params": { "name": "a", "ext": "pdf" }, "all": ["path", "pdf", "any-ext"], "note": "both pin the last segment with a regex; tie → tree order (wildcard before param)" },
        { "path": "/files/a/b.pdf", "match": "pdf", "params": { "0": "a/b" }, "all": ["path", "pdf"] },
        { "path": "/files/.pdf", "match": "pdf", "params": { "0": "" }, "all": ["path", "pdf"] },
        { "path": "/files/noext", "match": "path", "params": { "path": "noext" } },
        { "path": "/files/.htaccess", "match": "path", "params": { "path": ".htaccess" } },
        { "path": "/files/.env.local", "match": "any-ext", "params": { "name": ".env", "ext": "local" } },
        { "path": "/files/a/b.png", "match": "path", "params": { "path": "a/b.png" } },
        { "path": "/files//a.pdf", "match": "pdf", "params": { "0": "/a" }, "all": ["pdf"] },
        { "path": "/files", "match": null }
      ]
    },
    {
      "name": "content-hashed build assets",
      "description": "Vite-style `name-HASH.ext` files get immutable caching; the hash constraint lets the lazy name take dashes.",
      "routes": [
        { "method": "", "path": "/assets/**", "name": "assets-mw" },
        { "path": "/assets/:file", "name": "asset" },
        { "path": "/assets/:name-:hash([A-Za-z0-9_]{8}).:ext", "name": "hashed" }
      ],
      "guards": { "assets-mw": ["asset", "hashed"] },
      "cases": [
        { "path": "/assets/index-Bx3kQ9_a.js", "match": "hashed", "params": { "name": "index", "hash": "Bx3kQ9_a", "ext": "js" }, "all": ["assets-mw", "asset", "hashed"] },
        { "path": "/assets/vendor-react-Ab12Cd34.js", "match": "hashed", "params": { "name": "vendor-react", "hash": "Ab12Cd34", "ext": "js" } },
        { "path": "/assets/index-Bx3kQ9_a.js.map", "match": "hashed", "params": { "name": "index", "hash": "Bx3kQ9_a", "ext": "js.map" } },
        { "path": "/assets/logo.svg", "match": "asset", "params": { "file": "logo.svg" }, "all": ["assets-mw", "asset"] },
        { "path": "/assets/index-short.js", "match": "asset", "params": { "file": "index-short.js" } },
        { "path": "/assets/fonts/inter-Ab12Cd34.woff2", "match": "assets-mw", "params": { "0": "fonts/inter-Ab12Cd34.woff2" } },
        { "method": "HEAD", "path": "/assets/index-Bx3kQ9_a.js", "match": "assets-mw", "all": ["assets-mw"] },
        { "path": "/assets/", "match": "assets-mw", "params": {} }
      ]
    },
    {
      "name": "nuxt payloads, OG images and IPX",
      "description": "The docs/reference.md 'Segments after a catch-all' example extended with a `/**` fallback, OG images under any blog path and the IPX image proxy.",
      "routes": [
        { "path": "/**", "name": "spa" },
        { "path": "/blog/**", "name": "blog" },
        { "path": "/blog/:slug", "name": "post" },
        { "path": "/**/_payload.json", "name": "payload" },
        { "path": "/blog/:slug/_payload.json", "name": "post-payload" },
        { "path": "/blog/**:slug/og.png", "name": "og" },
        { "path": "/_ipx/:modifiers/**:path", "name": "ipx" },
        { "path": "/api/_content/**", "name": "content" }
      ],
      "cases": [
        { "path": "/blog/_payload.json", "match": "payload", "params": { "0": "blog" }, "all": ["spa", "blog", "post", "payload"] },
        { "path": "/blog/hello/_payload.json", "match": "post-payload", "params": { "slug": "hello" }, "all": ["spa", "blog", "payload", "post-payload"] },
        { "path": "/blog/hello/_payload.json/", "match": "post-payload", "params": { "slug": "hello" } },
        { "path": "/blog/hello", "match": "post", "params": { "slug": "hello" }, "all": ["spa", "blog", "post"] },
        { "path": "/blog", "match": "blog", "params": {}, "all": ["spa", "blog"] },
        { "path": "/blog/", "match": "blog", "params": {} },
        { "path": "/_payload.json", "match": "payload", "params": {}, "all": ["spa", "payload"] },
        { "path": "/about/team/_payload.json", "match": "payload", "params": { "0": "about/team" } },
        { "path": "/blog/hello/og.png", "match": "og", "params": { "slug": "hello" }, "all": ["spa", "blog", "og"] },
        { "path": "/blog/2024/hello/og.png", "match": "og", "params": { "slug": "2024/hello" } },
        { "path": "/blog/og.png", "match": "post", "params": { "slug": "og.png" }, "all": ["spa", "blog", "post"], "note": "`**:slug` needs a segment" },
        { "path": "/blog//og.png", "match": "blog", "params": { "0": "/og.png" }, "all": ["spa", "blog"] },
        { "path": "/_ipx/w_200/images/a.png", "match": "ipx", "params": { "modifiers": "w_200", "path": "images/a.png" }, "all": ["spa", "ipx"] },
        { "path": "/_ipx/_/logo.png", "match": "ipx", "params": { "modifiers": "_", "path": "logo.png" } },
        { "path": "/_ipx/w_200", "match": "spa", "params": { "0": "_ipx/w_200" } },
        { "path": "/_ipx/w_200//a.png", "match": "spa", "params": { "0": "_ipx/w_200//a.png" } },
        { "path": "/_ipx/w_200/_payload.json", "match": "payload", "params": { "0": "_ipx/w_200" }, "all": ["spa", "ipx", "payload"] },
        { "path": "/api/_content/query/abc", "match": "content", "params": { "0": "query/abc" } }
      ]
    },
    {
      "name": "nitro route rules merged from findAllRoutes",
      "description": "Method-agnostic route rules (prerender, ISR, cache, CORS) merged least → most specific, so the most specific rule wins.",
      "routes": [
        { "method": "", "path": "/**", "name": "defaults" },
        { "method": "", "path": "/blog/**", "name": "isr" },
        { "method": "", "path": "/blog/:slug", "name": "prerender" },
        { "method": "", "path": "/blog/drafts/**", "name": "no-cache" },
        { "method": "", "path": "/api/**", "name": "cors" },
        { "method": "", "path": "/_nuxt/**", "name": "immutable" },
        { "method": "", "path": "/admin/**", "name": "ssr-off" }
      ],
      "guards": { "defaults": ["isr", "prerender", "no-cache", "cors", "immutable", "ssr-off"], "isr": ["prerender", "no-cache"] },
      "cases": [
        { "path": "/", "match": "defaults", "all": ["defaults"] },
        { "path": "/blog/hello", "match": "prerender", "all": ["defaults", "isr", "prerender"] },
        { "path": "/blog/drafts/wip", "match": "no-cache", "params": { "0": "wip" }, "all": ["defaults", "isr", "no-cache"] },
        { "path": "/blog/drafts", "match": "no-cache", "params": {}, "all": ["defaults", "isr", "prerender", "no-cache"] },
        { "path": "/blog", "match": "isr", "all": ["defaults", "isr"] },
        { "path": "/blog/a/b", "match": "isr", "all": ["defaults", "isr"] },
        { "path": "/_nuxt/entry.js", "match": "immutable", "all": ["defaults", "immutable"] },
        { "method": "POST", "path": "/api/hello", "match": "cors", "all": ["defaults", "cors"] },
        { "method": "OPTIONS", "path": "/api", "match": "cors", "all": ["defaults", "cors"] },
        { "path": "/admin", "match": "ssr-off", "all": ["defaults", "ssr-off"] },
        { "path": "/administrator", "match": "defaults", "all": ["defaults"] }
      ],
      "invalid": ["/**/*.xml", "/blog/*/*.png", "/assets/x**"]
    },
    {
      "name": "next.js catch-all segments translated",
      "description": "`[...slug]` → `/docs/**:slug`, `[[...slug]]` → `/shop/:slug*`, `[lang]/[...rest]` → `/:lang/**:rest`.",
      "routes": [
        { "path": "/", "name": "home" },
        { "path": "/docs/**:slug", "name": "docs" },
        { "path": "/shop/:slug*", "name": "shop" },
        { "path": "/:lang", "name": "lang-home" },
        { "path": "/:lang/**:rest", "name": "lang-rest" },
        { "path": "/blog/:slug", "name": "blog-post" },
        { "path": "/_next/static/**", "name": "next-static" }
      ],
      "cases": [
        { "path": "/", "match": "home", "all": ["home"] },
        { "path": "/docs", "match": "lang-home", "params": { "lang": "docs" }, "note": "`[...slug]` needs a segment" },
        { "path": "/docs/a", "match": "docs", "params": { "slug": "a" }, "all": ["lang-rest", "docs"] },
        { "path": "/docs/a/b/c", "match": "docs", "params": { "slug": "a/b/c" } },
        { "path": "/docs/a/", "match": "docs", "params": { "slug": "a" } },
        { "path": "/docs/a//b", "match": null, "all": [] },
        { "path": "/shop", "match": "shop", "params": {}, "all": ["lang-home", "shop"] },
        { "path": "/shop/", "match": "shop", "params": {} },
        { "path": "/shop/shoes/red", "match": "shop", "params": { "slug": "shoes/red" }, "all": ["lang-rest", "shop"] },
        { "path": "/shop//", "match": null },
        { "path": "/en", "match": "lang-home", "params": { "lang": "en" } },
        { "path": "/en/guide/intro", "match": "lang-rest", "params": { "lang": "en", "rest": "guide/intro" } },
        { "path": "/en//", "match": null },
        { "path": "/blog/hello", "match": "blog-post", "params": { "slug": "hello" }, "all": ["lang-rest", "blog-post"] },
        { "path": "/blog/hello/comments", "match": "lang-rest", "params": { "lang": "blog", "rest": "hello/comments" } },
